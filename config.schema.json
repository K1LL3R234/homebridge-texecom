{
    "title": "Texecom",
    "pluginAlias": "Texecom",
    "pluginType": "platform",
    "headerDisplay": "Official Texecom Homebridge plugin.",
    "singular": true,
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "title": "Name",
                "required": true,
                "default": "Texecom",
                "description": "You shouldn't need to change this."
            },
            "ip_address": {
                "type": "string",
                "format": "ipv4",
                "title": "IP Address"
            },
            "ip_port": {
                "type": "integer",
                "default": 10001,
                "title": "IP Port"
            },
            "serial_device": {
                "type": "string",
                "example": "/dev/ttyUSB0",
                "title": "Serial Device"
            },
            "baud_rate": {
                "type": "integer",
                "enum": [
                    9600,
                    19200,
                    38400,
                    57600,
                    115200
                ],
                "title": "Baud Rate"
            },
            "udl": {
                "type": "integer",
                "minLength": 4,
                "maxLength": 6,
                "title": "UDL"
            },
            "remote_users": {
                "type": "array",
                "title": "Remote / Keyfob Users",
                "description": "Panel user numbers that arm using a remote or keyfob. An arm by one of these users is always shown as Away in HomeKit.",
                "items": {
                    "type": "integer",
                    "title": "User Number"
                }
            },
            "app_users": {
                "type": "array",
                "title": "App Users",
                "description": "Panel user numbers the panel reports when an area is armed from this plugin. An arm by one of these users is shown as whatever was asked for in HomeKit.",
                "items": {
                    "type": "integer",
                    "title": "User Number"
                }
            },
            "default_arm_state": {
                "type": "string",
                "title": "Default Arm State",
                "default": "away",
                "description": "What to show in HomeKit when an area is armed by any other user, at a keypad for example. The panel does not report whether an arm was full or part, so this is a best guess.",
                "enum": [
                    "away",
                    "night",
                    "stay"
                ]
            },
            "zones": {
                "type": "array",
                "title": "Zones",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "title": "Zone Name"
                        },
                        "zone_number": {
                            "type": "string",
                            "title": "Zone Number"
                        },
                        "zone_type": {
                            "type": "string",
                            "enum": [
                                "contact",
                                "motion",
                                "smoke",
                                "carbonmonoxide"
                            ],
                            "title": "Zone Type"
                        },
                        "dwell": {
                            "type": "integer",
                            "minimum": 0,
                            "title": "Dwell Time"
                        }
                    },
                    "required": [
                        "name",
                        "zone_number",
                        "zone_type",
                        "dwell"
                    ]
                }
            },
            "areas": {
                "type": "array",
                "title": "Areas",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "title": "Area Name"
                        },
                        "area_number": {
                            "type": "string",
                            "title": "Area Number"
                        },
                        "area_type": {
                            "type": "string",
                            "enum": [
                                "securitysystem"
                            ],
                            "title": "Area Type"
                        },
                        "dwell": {
                            "type": "integer",
                            "minimum": 0,
                            "title": "Dwell Time"
                        },
                        "zones": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            },
                            "title": "Zones under Area"
                        }
                    },
                    "required": [
                        "name",
                        "area_number",
                        "area_type",
                        "dwell"
                    ]
                }
            },
            "external_accessories": {
                "type": "boolean",
                "title": "Keep 4.3.0 External Accessories",
                "default": false,
                "description": "Only for installs that ran 4.3.0. That release published every zone and area outside the bridge, so they had to be added to the Home app by hand. Turn this on to keep publishing them that way, with the same identities, so the scenes, buttons and automations built on them keep working. Leave it off otherwise."
            },
            "debug":{
                "type":"boolean",
                "title":"Debug",
                "default":false
            }
        },
        "required": true
    }
}